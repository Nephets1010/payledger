<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>payledger</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>payledger-contract</artifactId>
  <name>payledger-contract</name>
  <description>跨模块共享的领域契约：不可变值对象（Money/Account/LedgerEntry/Transaction/外部流水等）、枚举、异常类型与纯逻辑校验器。零 Spring 依赖，仅依赖 JDK 21。</description>

  <!--
    ★ 本模块严禁引入任何 org.springframework.* 依赖。
      contract 是所有模块的依赖底座，必须保持零框架依赖，保证 store/core/starter/sample 都能无负担复用。
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.line.minimum>0.60</jacoco.line.minimum>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
